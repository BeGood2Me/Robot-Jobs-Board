# Neon Postgres connection string.
# Use the pooled URL (ends with -pooler) for Vercel / serverless.
# Direct URL is used by Prisma migrations.
# Production sets SNAPSHOT_ONLY=1 (vercel.json) so the public site does not query Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# Public site origin used in sitemaps, canonical URLs, and JSON-LD.
NEXT_PUBLIC_SITE_URL="https://www.robotjobsboard.com"

# Snapshot binaries (board.json.gz, bodies.json.gz, sitemaps) — GitHub snapshot-data branch.
# Default: raw.githubusercontent.com/BeGood2Me/Robot-Jobs-Board/snapshot-data/snapshot
# SNAPSHOT_BASE_URL="https://raw.githubusercontent.com/BeGood2Me/Robot-Jobs-Board/snapshot-data/snapshot"
# NEXT_PUBLIC_SNAPSHOT_BASE_URL=""
# SNAPSHOT_ONLY=1 skips Postgres on the public site (set in vercel.json).
# SNAPSHOT_UPLOAD_DB=1 to also write manifest/sitemaps into Neon (off by default — transfer cap).
# Optional Vercel Blob (Hobby store may be paused — do not use for per-job uploads).
# BLOB_READ_WRITE_TOKEN=""
# SNAPSHOT_UPLOAD_BLOB=1

# Google Analytics 4 measurement ID (optional; defaults in layout if unset).
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-6H8HLRSJ6J"

# Jobs not seen on the source board for this many days are marked inactive (default 1).
INGEST_INACTIVE_AFTER_DAYS="1"
INGEST_PURGE_AFTER_DAYS="30"

# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>.
# Also used if you hit GET /api/cron/ingest?secret=...
CRON_SECRET="change-me-cron"

# Password for /admin (hide or restore listings).
ADMIN_SECRET="change-me-admin"

# Optional normalized aggregator (JobListingsAPI or compatible).
# Leave blank to skip that connector.
JOB_LISTINGS_API_KEY=""
JOB_LISTINGS_API_BASE_URL="https://api.joblistingsapi.com/v1"

# Optional LLM classification (not used in v1; reserved for later).
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

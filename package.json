{
  "name": "robot-jobs-board",
  "private": true,
  "version": "0.1.0",
  "description": "Robot Jobs Board: robotics job board and content site",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @robot-jobs-board/db generate",
    "db:migrate": "pnpm --filter @robot-jobs-board/db migrate",
    "db:push": "pnpm --filter @robot-jobs-board/db push",
    "db:seed": "pnpm --filter @robot-jobs-board/db seed",
    "db:seed-feeds": "pnpm --filter @robot-jobs-board/db seed:feeds",
    "db:studio": "pnpm --filter @robot-jobs-board/db studio",
    "ingest:run": "pnpm --filter @robot-jobs-board/ingestion ingest:run",
    "ingest:cron": "pnpm --filter @robot-jobs-board/ingestion ingest:cron",
    "ingest:reclassify": "pnpm --filter @robot-jobs-board/ingestion ingest:reclassify",
    "postinstall": "pnpm db:generate"
  },
  "devDependencies": {
    "prisma": "^6.14.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  }
}
